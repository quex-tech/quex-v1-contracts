{
  "name": "smart-contracts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint:check": "yarn lint:version && yarn lint:sol-logic && yarn lint:sol-tests",
    "lint:fix": "forge fmt && yarn lint:sol-tests --fix && yarn lint:sol-logic --fix",
    "lint:sol-logic": "solhint -c .solhint.json 'contracts/**/*.sol' --max-warnings=0 --noPoster",
    "lint:sol-tests": "solhint -c test/.solhint.json 'test/**/*.sol' --max-warnings=0 --noPoster",
    "lint:version": "solhint --version",
    "test": "forge test -vvv",
    "prepare": "husky"
  },
